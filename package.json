{
  "name": "thriftsync",
  "version": "0.1.0",
  "private": true,
  "description": "Campus and local-community marketplace for buying, selling, renting, swapping and upcycling",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" --kill-others-on-fail \"npm run client:dev\" \"npm run server:dev\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:test": "npm --prefix client run test",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server run test",
    "test": "npm run client:test && npm run server:test"
  },
  "keywords": [
    "marketplace",
    "sustainability",
    "thrift",
    "rental",
    "campus"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
