# ThriftSync Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/thriftsync_dev

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_in_development
JWT_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Cloudinary / Image Storage (Optional in local dev)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Administrator Provisioning
ADMIN_EMAIL=admin@thriftsync.campus
ADMIN_PASSWORD=replace_with_secure_admin_password_min_8_chars
ADMIN_NAME=Campus Administrator
ADMIN_CAMPUS=Central Administration

# Razorpay Payment Gateway & Dedicated Webhook Verification
RAZORPAY_KEY_ID=placeholder_razorpay_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
